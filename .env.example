# ============================================================
# Granth Laptop Hub — Admin Panel
# Environment variables (copy to .env and fill in real values)
#
# NEVER commit a filled-in .env file. .env is git-ignored.
# This file documents variable NAMES only — no secrets here.
# ============================================================

# --- Firebase Admin SDK (SERVER ONLY) — required ---------------
# Used by /api/admin/* (create user, update user, reset password).
# Provide EITHER the full service-account JSON (recommended):
FIREBASE_SERVICE_ACCOUNT=
# ...OR the individual credential fields:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# (Alternative: point GOOGLE_APPLICATION_CREDENTIALS at a credentials file.)

# --- Image hosting — required for product image uploads --------
# ImgBB API key used by POST /api/upload-image.
IMGBB_API_KEY=

# --- Legacy Postgres layer — OPTIONAL, unused by default -------
# The Admin Panel runs on Firebase/Firestore. Only set this if you
# intentionally re-enable the legacy Postgres API routes (src/db).
DATABASE_URL=

# --- Client-side overrides — OPTIONAL --------------------------
# Defaults are baked into src/lib/firebase.ts so Admin + customer
# site always share one Firebase project. Set these only to point
# at a different project (e.g. a staging copy).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Public customer website (defaults to the live Vercel deployment):
NEXT_PUBLIC_CUSTOMER_WEBSITE_URL=
